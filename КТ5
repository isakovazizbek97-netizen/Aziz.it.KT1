function isItFridayToday() {
    let now = new Date();
    let day = now.getDay();
    
    if (day === 5) {
        console.log('Сегодня пятница');
    } else if (day === 6) {
        console.log('Пятница была вчера');
    } else if (day === 4) {
        console.log('Завтра пятница');
    } else {
        let daysToFriday = (5 - day + 7) % 7;
        if (daysToFriday === 1) {
            console.log('Пятница будет через 1 день');
        } else {
            console.log('Пятница будет через ' + daysToFriday + ' дней');
        }
    }
}

isItFridayToday();
