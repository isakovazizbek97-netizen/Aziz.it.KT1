def get_books(filename):
    books = []
    with open(filename, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = [part.strip() for part in line.split(',')]
            if len(parts) >= 5:
                try:
                    isbn = parts[0]
                    title = parts[1]
                    author = parts[2]
                    quantity = int(parts[3])
                    price = float(parts[4])
                    books.append([isbn, title, author, quantity, price])
                except:
                    continue
    return books
