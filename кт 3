def filtered_books(books, keyword):
    result = []
    keyword = keyword.lower()
    for book in books:
        title_author = (book[1] + " " + book[2]).lower()
        if keyword in title_author:
            combined = book[1] + ", " + book[2]
            new_book = [book[0], combined, book[3], book[4]]
            result.append(new_book)
    return result
