function generateArray(array) {
    for (let i = 0; i < array.length; i++) {
        if (typeof array[i] === "object" && array[i] !== null) {
            let values = [];
            for (let key in array[i]) {
                values.push(array[i][key]);
            }
            array[i] = values;
        }
    }
    return array;
}
