class Email {
    constructor(email) {
        this.setEmail(email);
    }

    setEmail(email) {
        this.email = email;
    }

    get isValid() {
        if (!this.email) return false;
        let parts = this.email.split('@');
        if (parts.length !== 2) return false;
        let login = parts[0];
        let domain = parts[1];
        if (login.length === 0) return false;
        if (domain.length > 3) return false;
        let forbidden = ['*', '#', '$', '%', '^', '&'];
        for (let char of forbidden) {
            if (login.includes(char)) return false;
        }
        return true;
    }
}

let email1 = new Email("newEmail@gmail.com");
console.log(email1.isValid);
