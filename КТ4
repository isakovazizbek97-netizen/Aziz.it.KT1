class Contact extends Email {
    constructor(email, phone) {
        super(email);
        this.phone = phone;
    }

    get phoneType() {
        if (!this.phone) return "Неизвестный";
        let cleanPhone = this.phone.replace(/\D/g, '');
        if (cleanPhone.length === 12) {
            return "Мобильный";
        } else if (cleanPhone.length === 10) {
            return "Городской";
        } else {
            return "Неизвестный";
        }
    }
}

