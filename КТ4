let users = [
    {id: 1, name: "Alex", lastname: "Williams", age: 20},
    {id: 2, name: "Steven", lastname: "King", age: 34}
];

function addUser(name, lastname, age) {
    let id = users.length + 1;
    users.push({id: id, name: name, lastname: lastname, age: age});
}

function updateUser(id, name, lastname, age) {
    for (let i = 0; i < users.length; i++) {
        if (users[i].id === id) {
            users[i].name = name;
            users[i].lastname = lastname;
            users[i].age = age;
            break;
        }
    }
}

function deleteUser(id) {
    for (let i = 0; i < users.length; i++) {
        if (users[i].id === id) {
            users.splice(i, 1);
            break;
        }
    }
}
