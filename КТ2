let num = 4;
let sum = 0;

for (let i = 1; i <= num; i++) {
    let currentSum = 0;
    for (let j = 1; j <= i; j++) {
        currentSum = currentSum + j;
    }
    sum = sum + currentSum;
}

console.log(sum);
